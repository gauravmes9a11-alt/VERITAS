# Copy to .env and edit. Nothing in the repository holds credentials, provider
# endpoints or model identifiers; everything environment-specific is injected here.

# ---- LLM provider (any OpenAI-compatible /chat/completions endpoint) ----
# Default below points at the bundled stub service so `docker compose up` works
# with no account. For a real run, replace the three values and set a provider
# spending limit first.
LLM_BASE_URL=http://stub-llm:8080/v1
LLM_MODEL=stub-model
LLM_API_KEY=
LLM_JSON_MODE=false            # true if the provider supports response_format=json_object
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=900
LLM_PRICE_IN_PER_1K=0.0        # USD per 1k prompt tokens (from your provider's price list)
LLM_PRICE_OUT_PER_1K=0.0       # USD per 1k completion tokens

# ---- Stub (load-test substitute for the provider, D6) ----
STUB_DELAY_MS=1500             # realistic per-call latency
STUB_JITTER_MS=400

# ---- Embeddings / index ----
EMBED_BACKEND=hash             # hash = offline deterministic (CI, quick start) | st = sentence-transformers
EMBED_MODEL=                   # sentence-transformers model name, used when EMBED_BACKEND=st
EMBED_DIM=384
CHUNKING=section_aware         # section_aware | naive (naive is the ablation baseline)
INDEX_NAME=main
# Set true to refuse to start when only synthetic fixtures were indexed (use for the real demo)
REQUIRE_OFFICIAL_CORPUS=false

# ---- Agent limits (A1) ----
PROMPT_VERSION=v2
MAX_STEPS=8
MAX_TOOL_CALLS=10
MAX_ROUNDS=2
RUN_DEADLINE_S=90
TOOL_TIMEOUT_S=10
AGENT_HTTP_TIMEOUT_S=60

# ---- Resilience (A5) ----
RETRY_MAX=3
RETRY_BASE_S=0.5
RETRY_CAP_S=8
BREAKER_FAILURE_THRESHOLD=4
BREAKER_WINDOW_S=30
BREAKER_COOLDOWN_S=20

# ---- Caching / rate limiting (D7) ----
CACHE_ENABLED=true
CACHE_TTL_S=3600
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_DAILY_RUNS=500
ALLOW_OPTIONS_OVERRIDE=true    # lets eval/loadtest pass options.no_cache / options.prompt_version

# ---- Guardrails (L4) ----
INJECTION_BLOCK_SCORE=3
TOXICITY_BLOCK_SCORE=2

# ---- Live quality scoring (L6) ----
LIVE_EVAL_SAMPLE_RATE=0.2

# ---- Infra wiring ----
REDIS_URL=redis://redis:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
GRAFANA_ADMIN_PASSWORD=change-me
